{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChemScan Companion",
  "version": "0.1.2",
  "identifier": "app.chemscan.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ChemScan Companion",
        "width": 300,
        "height": 430,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzMzMwNTcwNTE3QjQ5MjAKUldRZ1NYdFJjQVV6Zyt6OU9YdnhmS2J5MVdVOFN5eHh4QnMwcWU0cDZJWGhLbzk2RmJpMGZQeVUK",
      "endpoints": [
        "https://github.com/mehdiacho/chemscan-companion/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
